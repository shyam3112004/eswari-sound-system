  "description": "Eswari Sound System — scroll-cinematic event production website. Single provider. Hybrid booking: instant 25% advance + inquiry→quote→pay.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && (prisma db push --accept-data-loss || true) && (tsx prisma/seed.ts || true) && next build",
