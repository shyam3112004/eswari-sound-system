    "lenis": "^1.1.13",
    "lucide-react": "^0.400.0",
    "next": "14.2.5",
    "razorpay": "^2.9.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.52.0",
    "resend": "^4.0.0",
    "tailwind-merge": "^2.4.0",
    "tsx": "^4.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
